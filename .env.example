# Copy to .env and edit. Used by docker-compose.yml (and readable by start.bat users as a reference).

# Password for the PostgreSQL database. Change this before going live.
DB_PASSWORD=change-me

# Port the website is served on.
PORT=8080

# Order numbers restart at #1 each day in this time zone.
TIME_ZONE=Asia/Kolkata

# true  = anyone can create a restaurant account (multi-restaurant SaaS)
# false = only existing accounts can sign in (private install for one restaurant)
ALLOW_SIGNUP=true
